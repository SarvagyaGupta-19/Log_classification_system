# Log Classification System - Environment Configuration
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env to version control!

# ═══════════════════════════════════════════
# Application Settings
# ═══════════════════════════════════════════
# Environment: development or production
ENVIRONMENT=production

# Enable debug mode (NEVER set to True in production!)
DEBUG=False

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ═══════════════════════════════════════════
# LLM API Configuration (Groq)
# ═══════════════════════════════════════════
# Get your API key from: https://console.groq.com/keys
# Required for LegacyCRM logs and complex classification
GROQ_API_KEY=your_groq_api_key_here

# LLM Model (default: llama-3.3-70b-versatile)
LLM_MODEL=llama-3.3-70b-versatile

# LLM Temperature (0.0-1.0, default: 0.5)
LLM_TEMPERATURE=0.5

# ═══════════════════════════════════════════
# BERT Configuration
# ═══════════════════════════════════════════
# BERT model (default: all-MiniLM-L6-v2)
BERT_MODEL_NAME=all-MiniLM-L6-v2

# Model cache directory
MODEL_CACHE_DIR=models

# ═══════════════════════════════════════════
# File Processing Settings
# ═══════════════════════════════════════════
# Maximum upload file size in MB
MAX_FILE_SIZE_MB=50

# ═══════════════════════════════════════════
# Server Configuration
# ═══════════════════════════════════════════
# Application name and version
APP_NAME=Log Classification System
APP_VERSION=1.0.0

# CORS allowed origins (comma-separated)
# Development: http://localhost:8000,http://127.0.0.1:8000
# Production: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ═══════════════════════════════════════════
# Rate Limiting (Production Protection)
# ═══════════════════════════════════════════
# Enable rate limiting (recommended for production)
RATE_LIMIT_ENABLED=False

# Maximum requests per time window
RATE_LIMIT_REQUESTS=100

# Time window in seconds
RATE_LIMIT_WINDOW=60

# ═══════════════════════════════════════════
# Security Notes
# ═══════════════════════════════════════════
# 1. Always use strong API keys
# 2. Never commit .env file to git
# 3. Set DEBUG=False in production
# 4. Use ENVIRONMENT=production in production
# 5. Restrict CORS origins in production (see server.py)
# 6. Use environment variables in CI/CD pipelines
